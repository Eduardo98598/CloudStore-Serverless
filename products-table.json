        },
        {
          "AttributeName": "createdAt",
          "KeyType": "RANGE"
        }
      ],
      "Projection": {
        "ProjectionType": "ALL"
      }
    },
    {
      "IndexName": "CategoryIndex",
      "KeySchema": [
        {
          "AttributeName": "categoryId",
          "KeyType": "HASH"
        },
        {
          "AttributeName": "categorySort",
          "KeyType": "RANGE"
        }
      ],
      "Projection": {
        "ProjectionType": "ALL"
      }
    }
  ]
}
